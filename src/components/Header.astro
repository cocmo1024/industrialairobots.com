---
import { NAV, SITE } from '../site';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href="/"><Logo /> <span>Industrial <b>AI</b> Robots</span><span class="sr-only"> — {SITE.name} home</span></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav">Menu</button>
    <nav class="nav" id="nav" aria-label="Main">
      {NAV.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
  </div>
</header>
<script>
  const b = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const n = document.getElementById('nav');
  b?.addEventListener('click', () => {
    const open = n?.classList.toggle('open');
    b.setAttribute('aria-expanded', String(!!open));
  });
</script>
