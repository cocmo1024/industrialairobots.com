---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { eyebrow?: string; title: string; lede?: string; crumbs?: { name: string; href?: string }[] }
const { eyebrow, title, lede, crumbs } = Astro.props;
---
<div class="band">
  <div class="wrap page-head">
    {crumbs && <Breadcrumbs items={crumbs} />}
    {eyebrow && <div class="eyebrow">{eyebrow}</div>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</div>
