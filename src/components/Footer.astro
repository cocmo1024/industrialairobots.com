---
import { FOOTER_NAV, SITE } from '../site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <h2>{SITE.name}</h2>
        <p>{SITE.tagline}</p>
        <p>Independent. Not affiliated with any robot manufacturer. Every spec links to its source.</p>
      </div>
      {FOOTER_NAV.map((col) => (
        <div>
          <h2>{col.title}</h2>
          <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="legal">© {year} {SITE.name}. Product names and trademarks belong to their owners. Specifications can change — confirm with the manufacturer before you buy.</div>
  </div>
</footer>
