---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { TOPICS } from '../../lib/topics';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => !g.data.draft);
  return guides.map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const { Content } = await render(g);
const d = g.data;
const iso = (x: Date) => x.toISOString().slice(0, 10);
const ld = {
  '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description,
  datePublished: iso(d.published), dateModified: iso(d.updated), url: `${SITE.url}/guides/${g.id}/`,
  author: { '@id': `${SITE.url}/#organization` },
  publisher: { '@id': `${SITE.url}/#organization` },
};
---
<Base title={d.title} description={d.description} ogType="article" jsonLd={ld}>
  <PageHead eyebrow={TOPICS[d.topic]} title={d.title} crumbs={[{ name: 'Guides', href: '/guides/' }, { name: d.title }]}>
    <p style="color:var(--ink-muted);font-size:var(--fs-6);margin:0">Updated <time datetime={iso(d.updated)}>{iso(d.updated)}</time></p>
  </PageHead>
  <div class="wrap section">
    <article class="prose">
      <Content />
      {d.sources.length > 0 && (
        <>
          <h2>Sources</h2>
          <ol class="sources">{d.sources.map((s) => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a></li>)}</ol>
        </>
      )}
    </article>
  </div>
</Base>
