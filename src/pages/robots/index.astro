---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { robots, brands, categories, brandBySlug, categoryBySlug, formatSpec, robotUrl, STATUS_LABEL } from '../../lib/db';
const usedCats = categories.filter((c) => robots.some((r) => r.category === c.slug));
// Dataset dates track the per-entry `updated` (last checked) field: dateModified is the
// most recent entry check, datePublished the earliest. Never hard-code these.
const dateModified = robots.map((r) => r.updated).sort().at(-1)!;
const datePublished = robots.map((r) => r.updated).sort()[0];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': 'https://industrialairobots.com/robots/#dataset',
  name: 'Industrial AI Robots — Robot Specification Database',
  alternateName: [
    'Industrial robot specifications database',
    'Cobot and humanoid robot specs dataset',
    'industrialairobots.com robots.json dataset',
  ],
  description:
    `Specifications for ${robots.length} industrial robot arms, collaborative robots (cobots), ` +
    `SCARA robots and humanoid robots from ${brands.length} manufacturers. Every value is ` +
    `transcribed from the manufacturer's own product page, datasheet or manual; each record in ` +
    `the JSON download carries its own source URL, publisher and retrieval date. Values a ` +
    `manufacturer does not publish are left blank, never estimated. Each record also carries a ` +
    `status label (in production, early access, preliminary specs, discontinued) and the date ` +
    `the entry was last checked; entries are re-checked on a rolling basis.`,
  url: 'https://industrialairobots.com/robots/',
  mainEntityOfPage: 'https://industrialairobots.com/robots/',
  identifier: 'https://industrialairobots.com/data/robots.json',
  keywords: ['industrial robots', 'cobot specifications', 'humanoid robots', 'robot database',
    'rated payload', 'reach', 'repeatability', 'SCARA', 'physical AI'],
  inLanguage: 'en',
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creditText:
    'Specification values © their respective manufacturers. Compilation and annotations ' +
    '© Industrial AI Robots, CC BY 4.0 — credit “Industrial AI Robots” with a link.',
  version: dateModified,
  datePublished,
  dateModified,
  creator: { '@id': 'https://industrialairobots.com/#organization' },
  publisher: { '@id': 'https://industrialairobots.com/#organization' },
  measurementTechnique:
    'Manual transcription from the robot manufacturer’s official product page, datasheet or ' +
    'manual (the only accepted source class; distributor and aggregator listings are not used). ' +
    'Manufacturer qualifiers are preserved in a per-value note field. Unpublished values are ' +
    'omitted. See https://industrialairobots.com/methodology/ for the full sourcing rules.',
  variableMeasured: [
    { '@type': 'PropertyValue', propertyID: 'payloadKg', name: 'Rated payload', unitText: 'kg', description: 'Nominal payload at the manufacturer’s stated load conditions and load diagram.' },
    { '@type': 'PropertyValue', propertyID: 'payloadMaxKg', name: 'Max / extended payload', unitText: 'kg', description: 'Extended or peak payload where the manufacturer publishes one.' },
    { '@type': 'PropertyValue', propertyID: 'reachMm', name: 'Reach', unitText: 'mm', description: 'Maximum reach from the base (J1) axis, as published.' },
    { '@type': 'PropertyValue', propertyID: 'axes', name: 'Axes', description: 'Number of robot axes (articulated arms).' },
    { '@type': 'PropertyValue', propertyID: 'dof', name: 'Degrees of freedom', description: 'Total actuated degrees of freedom as published (humanoid and mobile robots).' },
    { '@type': 'PropertyValue', propertyID: 'repeatabilityMm', name: 'Repeatability', unitText: 'mm', description: 'Pose repeatability as published (± value); repeatability is not accuracy.' },
    { '@type': 'PropertyValue', propertyID: 'weightKg', name: 'Robot weight', unitText: 'kg', description: 'Manipulator weight as published; inclusion of cables/controller follows the manufacturer’s wording and per-value notes. Conflicting manufacturer documents → left blank with the conflict noted.' },
    { '@type': 'PropertyValue', propertyID: 'heightMm', name: 'Height', unitText: 'mm', description: 'Standing height (humanoid and mobile robots).' },
    { '@type': 'PropertyValue', propertyID: 'maxTcpSpeedMs', name: 'Max TCP speed', unitText: 'm/s', description: 'Maximum tool-centre-point speed as published.' },
    { '@type': 'PropertyValue', propertyID: 'speedMs', name: 'Moving speed', unitText: 'm/s', description: 'Locomotion speed as published (humanoid and mobile robots).' },
    { '@type': 'PropertyValue', propertyID: 'runtimeH', name: 'Runtime per charge', unitText: 'h', description: 'Operating time per battery charge as published.' },
    { '@type': 'PropertyValue', propertyID: 'batteryWh', name: 'Battery capacity', unitText: 'Wh', description: 'Battery capacity as published.' },
    { '@type': 'PropertyValue', propertyID: 'ipRating', name: 'Protection rating', description: 'IEC 60529 IP code as published (text); wrist-only ratings qualified in the per-value note.' },
    { '@type': 'PropertyValue', propertyID: 'footprintMm', name: 'Base footprint', unitText: 'mm', description: 'Base mounting footprint diameter as published.' },
    { '@type': 'PropertyValue', propertyID: 'mounting', name: 'Mounting', description: 'Permitted mounting orientations as published, as a list.' },
    { '@type': 'PropertyValue', propertyID: 'controller', name: 'Controller', description: 'Manufacturer controller model named for the robot (text).' },
    { '@type': 'PropertyValue', propertyID: 'priceUsd', name: 'Published price', unitText: 'USD', description: 'Public list price in USD — recorded only when the manufacturer itself publishes one; absent otherwise.' },
  ],
  distribution: [{
    '@type': 'DataDownload',
    encodingFormat: 'application/json',
    contentUrl: 'https://industrialairobots.com/data/robots.json',
  }],
};
---
<Base title="Robot Database: Specs for Industrial Robots, Cobots, Humanoids" description="Filter industrial robots, cobots and humanoids by payload, reach and type. Every spec is cited to the manufacturer, with a free JSON download." jsonLd={ld}>
  <PageHead eyebrow="Robot database" title="Find a robot by payload, reach and type" lede="Every value is copied from the manufacturer’s own page and linked to it. If a maker doesn’t state a number, we show a dash — we don’t guess." crumbs={[{ name: 'Robots' }]} />

  <div class="wrap section">
    <form class="fields card" id="finder" role="search" aria-label="Filter robots">
      <div><label for="q">Search</label><input id="q" type="search" placeholder="e.g. UR20, humanoid" autocomplete="off" /></div>
      <div><label for="cat">Type</label><select id="cat"><option value="">All types</option>{usedCats.map((c) => <option value={c.slug}>{c.short}</option>)}</select></div>
      <div><label for="brand">Brand</label><select id="brand"><option value="">All brands</option>{brands.map((b) => <option value={b.slug}>{b.name}</option>)}</select></div>
      <div><label for="pay">Min payload <span class="unit">kg</span></label><input id="pay" type="number" min="0" step="0.5" inputmode="decimal" /></div>
      <div><label for="reach">Min reach <span class="unit">mm</span></label><input id="reach" type="number" min="0" step="50" inputmode="numeric" /></div>
    </form>

    <p class="muted" id="count" aria-live="polite" style="margin:16px 0 10px">{robots.length} robots</p>
    <div class="table-wrap">
      <table id="table">
        <thead><tr>
          <th><button type="button" class="sort" data-k="name">Model</button></th><th>Type</th>
          <th class="num"><button type="button" class="sort" data-k="pay">Payload</button></th>
          <th class="num"><button type="button" class="sort" data-k="reach">Reach</button></th>
          <th class="num">Repeat.</th><th class="num"><button type="button" class="sort" data-k="weight">Weight</button></th><th>Status</th>
        </tr></thead>
        <tbody>
          {robots.map((r) => (
            <tr data-name={`${brandBySlug(r.brand)?.name} ${r.name} ${r.family ?? ''} ${categoryBySlug(r.category)?.name}`.toLowerCase()}
                data-cat={r.category} data-brand={r.brand} data-pay={r.specs.payloadKg ?? ''} data-reach={r.specs.reachMm ?? ''} data-weight={r.specs.weightKg ?? ''}>
              <td><a href={robotUrl(r)}><strong>{r.name}</strong></a><br /><span class="muted" style="font-size:var(--fs-6)">{brandBySlug(r.brand)?.name}</span></td>
              <td>{categoryBySlug(r.category)?.short}</td>
              <td class="num mono">{formatSpec('payloadKg', r.specs.payloadKg)}</td>
              <td class="num mono">{formatSpec('reachMm', r.specs.reachMm)}</td>
              <td class="num mono">{formatSpec('repeatabilityMm', r.specs.repeatabilityMm)}</td>
              <td class="num mono">{formatSpec('weightKg', r.specs.weightKg)}</td>
              <td><span class:list={['badge', r.status]}>{STATUS_LABEL[r.status]}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted" style="font-size:var(--fs-8);margin-top:12px">Download the full dataset: <a href="/data/robots.json">robots.json</a> (CC BY 4.0 — credit “Industrial AI Robots” with a link). Missing a robot? <a href="/contact/">Tell us</a>.</p>
  </div>
</Base>

<style>
  .sort { all: unset; cursor: pointer; }
  .sort::after { content: ' ↕'; opacity: .45; }
  .sort:focus-visible { outline: 2px solid var(--accent); }
</style>

<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const q = $<HTMLInputElement>('q'), cat = $<HTMLSelectElement>('cat'), brand = $<HTMLSelectElement>('brand');
  const pay = $<HTMLInputElement>('pay'), reach = $<HTMLInputElement>('reach'), count = $('count');
  const tbody = document.querySelector('#table tbody')!;
  const rows = [...tbody.querySelectorAll<HTMLTableRowElement>('tr')];

  // Restore filters from the URL so filtered views can be shared.
  const params = new URLSearchParams(location.search);
  q.value = params.get('q') ?? ''; cat.value = params.get('type') ?? ''; brand.value = params.get('brand') ?? '';
  pay.value = params.get('payload') ?? ''; reach.value = params.get('reach') ?? '';

  function apply() {
    const text = q.value.trim().toLowerCase();
    const minP = parseFloat(pay.value), minR = parseFloat(reach.value);
    let n = 0;
    for (const tr of rows) {
      const d = tr.dataset;
      const ok = (!text || d.name!.includes(text)) && (!cat.value || d.cat === cat.value) && (!brand.value || d.brand === brand.value)
        && (isNaN(minP) || (d.pay !== '' && Number(d.pay) >= minP)) && (isNaN(minR) || (d.reach !== '' && Number(d.reach) >= minR));
      tr.hidden = !ok; if (ok) n++;
    }
    count.textContent = `${n} of ${rows.length} robots`;
    const p = new URLSearchParams();
    if (q.value) p.set('q', q.value); if (cat.value) p.set('type', cat.value); if (brand.value) p.set('brand', brand.value);
    if (pay.value) p.set('payload', pay.value); if (reach.value) p.set('reach', reach.value);
    history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
  }
  document.getElementById('finder')!.addEventListener('input', apply);
  document.getElementById('finder')!.addEventListener('submit', (e) => e.preventDefault());

  let dir = 1, last = '';
  document.querySelectorAll<HTMLButtonElement>('.sort').forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.k!; dir = k === last ? -dir : 1; last = k;
    const val = (tr: HTMLTableRowElement) => (k === 'name' ? tr.dataset.name! : tr.dataset[k] === '' ? Infinity : Number(tr.dataset[k]));
    rows.sort((a, c) => { const x = val(a), y = val(c); return (x < y ? -1 : x > y ? 1 : 0) * dir; }).forEach((tr) => tbody.appendChild(tr));
  }));
  apply();
</script>
