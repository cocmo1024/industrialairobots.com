---
import ToolPage from '../../components/ToolPage.astro';
import Field from '../../components/Field.astro';
---
<ToolPage
  slug="cycle-time-calculator"
  title="Robot Cycle Time Calculator: Parts per Hour and Takt Time"
  description="Convert robot cycle time to parts per hour, per shift and per day, or find the cycle time you need for a target output. Includes takt time."
  lede="Turn a cycle time into real output, including downtime — or work back from the output you need."
>
  <Fragment slot="inputs">
    <div class="fields">
      <Field id="ct" label="Cycle time" unit="s" value="12" step="0.1" />
      <Field id="ppc" label="Parts per cycle" value="1" step="1" />
      <Field id="eff" label="Efficiency" unit="%" value="85" step="1" max="100" />
      <Field id="hps" label="Hours per shift" value="8" step="0.5" />
      <Field id="spd" label="Shifts per day" value="2" step="1" />
    </div>
    <h2 style="margin:8px 0 0;font-size:var(--fs-11)">Work back from a target</h2>
    <div class="fields">
      <Field id="target" label="Target output" unit="parts/h" value="250" step="1" />
      <Field id="demand" label="Daily demand" unit="parts/day" value="3000" step="10" />
    </div>
  </Fragment>

  <Fragment slot="results">
    <h2>Output</h2>
    <div class="big"><span id="pph">—</span><small>parts/h</small></div>
    <dl class="kv">
      <dt>Ideal (100 % running)</dt><dd id="ideal">—</dd>
      <dt>Per shift</dt><dd id="pps">—</dd>
      <dt>Per day</dt><dd id="ppd">—</dd>
      <dt>Max cycle time for target</dt><dd id="req">—</dd>
      <dt>Takt time for daily demand</dt><dd id="takt">—</dd>
      <dt>Daily demand covered</dt><dd id="cover">—</dd>
    </dl>
    <p class="err" id="err" hidden>All inputs must be greater than zero; efficiency at most 100 %.</p>
  </Fragment>

  <h2>Formulas</h2>
  <ul>
    <li><strong>Ideal parts per hour</strong> = 3600 ÷ cycle time × parts per cycle.</li>
    <li><strong>Real parts per hour</strong> = ideal × efficiency. Use availability × performance from your OEE data if you have it; otherwise be conservative.</li>
    <li><strong>Max cycle time for a target</strong> = 3600 × parts per cycle × efficiency ÷ target per hour.</li>
    <li><strong>Takt time</strong> = available time per day ÷ daily demand. The real cycle time (after efficiency) must be shorter.</li>
  </ul>
  <h2>Where cycle time really goes</h2>
  <p>Robot motion is often the smaller part of a cycle. Gripper open/close and vacuum build-up, waiting for a machine door or a CNC cycle, vision acquisition and processing, and safety-rated speed limits when people are nearby all add time. Measure a full cycle on a simulation or a trial cell before committing to an output figure.</p>
</ToolPage>

<script>
  import { throughput, requiredCycleTime, taktTime } from '../../lib/calc/throughput';
  import { val, out, fmt, bindForm, valid } from '../../lib/ui';
  bindForm(document.getElementById('calc') as HTMLFormElement, () => {
    const i = { cycleTimeS: val('ct'), partsPerCycle: val('ppc'), efficiencyPct: val('eff'), hoursPerShift: val('hps'), shiftsPerDay: val('spd') };
    const target = val('target'), demand = val('demand');
    const ok = valid([...Object.values(i), target, demand]) && i.efficiencyPct <= 100;
    document.getElementById('err')!.hidden = ok;
    if (!ok) return;
    const r = throughput(i);
    out('pph', fmt(r.partsPerHour, 1));
    out('ideal', `${fmt(r.idealPerHour, 1)} /h`);
    out('pps', fmt(r.partsPerShift));
    out('ppd', fmt(r.partsPerDay));
    out('req', `${fmt(requiredCycleTime(target, i.partsPerCycle, i.efficiencyPct), 2)} s`);
    out('takt', `${fmt(taktTime(i.hoursPerShift * i.shiftsPerDay, demand), 2)} s/part`);
    out('cover', `${fmt((r.partsPerDay / demand) * 100, 0)} %`);
  });
</script>
